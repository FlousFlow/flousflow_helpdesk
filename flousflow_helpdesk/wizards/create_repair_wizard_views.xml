<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_create_repair_wizard_view_form" model="ir.ui.view">
        <field name="name">flousflow.helpdesk.create.repair.wizard.form</field>
        <field name="model">flousflow.helpdesk.create.repair.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Repair Order">
                <group>
                    <field name="ticket_id" invisible="1"/>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                </group>
                <footer>
                    <button name="action_create_repair" type="object"
                            string="Create" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
