<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_helpdesk_ticket" model="report.paperformat">
        <field name="name">Helpdesk Ticket (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">52</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">52</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="helpdesk_ticket_report" model="ir.actions.report">
        <field name="name">Helpdesk Ticket</field>
        <field name="model">flousflow.helpdesk.ticket</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">flousflow_helpdesk.ticket_report</field>
        <field name="report_file">flousflow_helpdesk.ticket_report</field>
        <field name="print_report_name">('Helpdesk Ticket - %s' % (object.name))</field>
        <field name="paperformat_id" ref="flousflow_helpdesk.paperformat_helpdesk_ticket"/>
        <field name="binding_model_id" ref="model_flousflow_helpdesk_ticket"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
