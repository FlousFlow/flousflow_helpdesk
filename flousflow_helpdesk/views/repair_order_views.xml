<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_order_form_inherit_helpdesk" model="ir.ui.view">
        <field name="name">repair.order.form.helpdesk</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ticket" type="object"
                        class="oe_stat_button" icon="fa-life-ring"
                        invisible="not helpdesk_ticket_id">
                    <field name="helpdesk_ticket_id" widget="statinfo" string="Helpdesk Ticket"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
