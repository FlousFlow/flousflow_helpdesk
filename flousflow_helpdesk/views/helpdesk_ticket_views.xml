<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_kanban" model="ir.ui.view">
        <field name="name">flousflow.helpdesk.ticket.kanban</field>
        <field name="model">flousflow.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_mobile">
                <field name="name"/>
                <field name="priority"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="tag_ids"/>
                <field name="repair_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong><field name="name"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="text-muted o_kanban_record_subtitle">
                                <field name="partner_id"/>
                            </div>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <div class="o_kanban_record_bottom">
                                <field name="user_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="helpdesk_ticket_view_list" model="ir.ui.view">
        <field name="name">flousflow.helpdesk.ticket.list</field>
        <field name="model">flousflow.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'done'" decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="team_id"/>
                <field name="stage_id"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"/>
                <field name="repair_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">flousflow.helpdesk.ticket.form</field>
        <field name="model">flousflow.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state in ['done', 'cancelled']"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ['done', 'cancelled']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_repair" type="object"
                                class="oe_stat_button" icon="fa-wrench"
                                string="Create Repair"
                                invisible="repair_id"/>
                        <button name="action_view_repair" type="object"
                                class="oe_stat_button" icon="fa-wrench"
                                invisible="not repair_id">
                            <field name="repair_id" widget="statinfo" string="Repair"/>
                        </button>
                        <button name="action_open_tracking" type="object"
                                class="oe_stat_button" icon="fa-link"
                                string="Tracking Link"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Subject"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="stage_id"/>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Repair">
                        <group>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="helpdesk_ticket_view_search" model="ir.ui.view">
        <field name="name">flousflow.helpdesk.ticket.search</field>
        <field name="model">flousflow.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="stage_id"/>
                <field name="tag_ids"/>
                <filter name="my_tickets" string="My Tickets" domain="[('user_id', '=', uid)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter name="state_draft" string="New" domain="[('state', '=', 'draft')]"/>
                <filter name="state_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="state_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="state_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <group>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_user" string="Assigned To" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="helpdesk_ticket_action" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">flousflow.helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="helpdesk_ticket_view_search"/>
        <field name="context">{'search_default_partner_id': active_id}</field>
        <field name="help">Create and manage support tickets. Use the
            "Create Repair" button to link a repair order.</field>
    </record>
</odoo>
