<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ticket_tracking_page">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Repair Status</title>
                <style>
                    body { font-family: system-ui, -apple-system, sans-serif; background: #f5f6fa; margin: 0; padding: 24px; }
                    .card { max-width: 560px; margin: 24px auto; background: #fff; border-radius: 12px; padding: 28px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
                    h2 { margin: 0 0 16px; color: #1f2937; }
                    .row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #eee; }
                    .row:last-child { border-bottom: none; }
                    .label { color: #6b7280; }
                    .value { font-weight: 600; color: #111827; text-align: right; }
                    .badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 13px; font-weight: 600; }
                    .badge-done { background: #d1fae5; color: #065f46; }
                    .badge-progress { background: #dbeafe; color: #1e40af; }
                    .badge-draft { background: #fef3c7; color: #92400e; }
                    .badge-cancelled { background: #fee2e2; color: #991b1b; }
                </style>
            </head>
            <body>
                <div class="card">
                    <h2>Repair Status</h2>

                    <div class="row">
                        <span class="label">Ticket</span>
                        <span class="value"><t t-esc="ticket.name"/></span>
                    </div>
                    <div class="row">
                        <span class="label">Ticket Status</span>
                        <span class="value"><t t-esc="ticket._get_state_display()"/></span>
                    </div>

                    <t t-if="repair">
                        <div class="row">
                            <span class="label">Repair Reference</span>
                            <span class="value"><t t-esc="repair.name"/></span>
                        </div>
                        <div class="row">
                            <span class="label">Repair Status</span>
                            <span class="value">
                                <span class="badge" t-att-class="'badge-' + ('done' if repair.state == 'done' else 'cancelled' if repair.state == 'cancel' else 'progress' if repair.state in ('confirmed', 'under_repair') else 'draft')">
                                    <t t-esc="repair._get_state_display()"/>
                                </span>
                            </span>
                        </div>
                        <div class="row" t-if="repair.product_id">
                            <span class="label">Product</span>
                            <span class="value"><t t-esc="repair.product_id.display_name"/></span>
                        </div>
                        <div class="row" t-if="repair.schedule_date">
                            <span class="label">Scheduled Date</span>
                            <span class="value"><t t-esc="repair.schedule_date"/></span>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="row">
                            <span class="label">Repair Order</span>
                            <span class="value">Not created yet</span>
                        </div>
                    </t>
                </div>
            </body>
        </html>
    </template>
</odoo>
