<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_team_view_list" model="ir.ui.view">
        <field name="name">flousflow.helpdesk.team.list</field>
        <field name="model">flousflow.helpdesk.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_team_view_form" model="ir.ui.view">
        <field name="name">flousflow.helpdesk.team.form</field>
        <field name="model">flousflow.helpdesk.team</field>
        <field name="arch" type="xml">
            <form string="Team">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <group string="Members">
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Stages">
                        <field name="stage_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">flousflow.helpdesk.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
