<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_tag_view_list" model="ir.ui.view">
        <field name="name">flousflow.helpdesk.tag.list</field>
        <field name="model">flousflow.helpdesk.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_tag_view_form" model="ir.ui.view">
        <field name="name">flousflow.helpdesk.tag.form</field>
        <field name="model">flousflow.helpdesk.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">flousflow.helpdesk.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
